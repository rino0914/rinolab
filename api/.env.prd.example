PORT=3000
API_BIND_HOST=127.0.0.1
MONGODB_URI=mongodb://CHANGE_ME_USER:CHANGE_ME_PASSWORD@127.0.0.1:27017/?authSource=admin
MONGODB_DB=rinolab
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_VALUE
NODE_ENV=production
OIDC_ENABLED=true
OIDC_ISSUER=https://auth.rinolab.org
OIDC_ACCOUNT_ORIGIN=https://rinolab.org
OIDC_SIGNING_KEY_PATH=/etc/rinolab/oidc-jwks.json
OIDC_SIGNING_KEY=
OIDC_COOKIE_KEYS=CHANGE_ME_CURRENT_COOKIE_KEY_AT_LEAST_32_CHARS,CHANGE_ME_PREVIOUS_COOKIE_KEY_AT_LEAST_32_CHARS
OIDC_CLIENT_ID=immich
OIDC_CLIENT_NAME=Immich
OIDC_CLIENT_SECRET=CHANGE_ME_TO_A_RANDOM_CLIENT_SECRET
OIDC_REDIRECT_URIS=https://photo.rinolab.org/auth/login,https://photo.rinolab.org/user-settings,https://photo.rinolab.org/api/oauth/mobile-redirect
OIDC_POST_LOGOUT_REDIRECT_URIS=https://photo.rinolab.org/
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
